<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Console app for trying this branch of the SDK on macOS, Linux or Windows.
    It references the SDK project directly, so it always runs the code in this checkout.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../EBay.ListingManagement/EBay.ListingManagement.csproj" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.*" />
  </ItemGroup>

</Project>
