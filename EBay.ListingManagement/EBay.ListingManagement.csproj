<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net472;net8.0;net9.0;net10.0</TargetFrameworks>
    <RootNamespace>EBay.ListingManagement</RootNamespace>
    <AssemblyName>EBay.ListingManagement</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Version>0.5.0</Version>
    <Authors>eBay</Authors>
    <Description>Listing Management SDK for eBay APIs - combines REST and GraphQL clients</Description>
    <PackageProjectUrl>https://github.com/eBay/listing-management-dotnet-sdk</PackageProjectUrl>
    <RepositoryUrl>https://github.com/eBay/listing-management-dotnet-sdk</RepositoryUrl>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <!-- PolySharp 1.17 generates IsClosedTypeAttribute as public; keep it out of the SDK's public API (PublicApiTests). -->
    <PolySharpExcludeGeneratedTypes>System.Runtime.CompilerServices.IsClosedTypeAttribute</PolySharpExcludeGeneratedTypes>
  </PropertyGroup>

  <ItemGroup>
    <!-- REST: Kiota runtime -->
    <PackageReference Include="Microsoft.Kiota.Bundle" Version="$(KiotaVersion)" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="$(DependencyInjectionVersion)" />

    <!-- Compiler attributes (init, required, nullable) for net472. A build-time source generator: pinned, upgrade deliberately. -->
    <PackageReference Include="PolySharp" Version="1.17.0" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
  </ItemGroup>

  <!-- .NET Framework: System.Text.Json and System.Net.Http are not in the framework -->
  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">
    <PackageReference Include="System.Text.Json" Version="$(SystemTextJsonVersion)" />
    <Reference Include="System.Net.Http" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

</Project>
