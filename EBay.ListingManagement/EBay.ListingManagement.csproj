<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>EBay.ListingManagement</RootNamespace>
    <AssemblyName>EBay.ListingManagement</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- REST: Kiota runtime -->
    <PackageReference Include="Microsoft.Kiota.Bundle" Version="1.*" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.*" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.*" />

    <!-- GraphQL: StrawberryShake runtime + Roslyn source generator -->
    <PackageReference Include="StrawberryShake.Server" Version="15.*" />
  </ItemGroup>

</Project>
